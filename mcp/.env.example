# Base URL of the Comics Now! app. Localhost / trusted-LAN IPs are treated as
# admin by the app's auth middleware, so no Cloudflare token is needed here.
COMICS_BASE_URL=http://localhost:3000

# Path to the app's SQLite database (used by the read-only query_db tool).
# Defaults automatically to ../comics-now.db relative to this directory.
# COMICS_DB_PATH=/path/to/comics-now.db

# Set to 1 to allow destructive endpoints via call_api (move/rename/delete,
# tagger apply/run, metadata migrate, settings/library config, guided run).
# Default off (0) = safe writes only.
COMICS_ALLOW_DESTRUCTIVE=0

# HTTP timeout (seconds) for calls to the app.
COMICS_TIMEOUT=60

# Optional: extra HTTP headers as JSON, e.g. a Cloudflare service token when
# targeting a remote instance: {"CF-Access-Client-Id":"...","CF-Access-Client-Secret":"..."}
# COMICS_EXTRA_HEADERS={}

# Optional network server configuration (when not running in default stdio mode):
# MCP_TRANSPORT=stdio          # 'stdio' (default) or 'sse'
# MCP_HOST=127.0.0.1           # Defaults to 127.0.0.1 (loopback). Set to 0.0.0.0 only if deliberately exposing
# MCP_PORT=8000

