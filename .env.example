# Comics Now Server Environment Configuration
PORT=3000
BASE_URL=/comics
COMICS_LOCATION=/path/to/comics/processing-inbox

# Cloudflare Zero Trust Configuration
CF_TEAM_DOMAIN=yourteam.cloudflareaccess.com
CF_AUDIENCE=your-application-audience-tag
ADMIN_EMAIL=admin@example.com
USER_EMAIL=user@example.com

# Third-Party API Keys & Credentials
COMICVINE_API_KEY=
GOOGLE_BOOKS_API_KEY=
METRON_USER=
METRON_PASSWORD=

# Reverse Proxy Trust (set to true or specific proxy hop count when behind Cloudflare)
TRUST_PROXY=1
