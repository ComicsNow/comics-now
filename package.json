{
  "name": "comics-now",
  "version": "1.0.0",
  "description": "A simple comic reader app.",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "build:css": "tailwindcss -i ./styles/tailwind.css -o ./public/tailwind.css --minify",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:e2e": "playwright test",
    "test:all": "npm run test && npm run test:e2e",
    "postinstall": "node scripts/check-dependencies.js",
    "mcp": "bash mcp/run.sh"
  },
  "license": "AGPL-3.0",
  "dependencies": {
    "@eslint/js": "^9.39.5",
    "archiver": "^5.3.2",
    "better-sqlite3": "^12.11.1",
    "cors": "^2.8.6",
    "express": "^4.22.2",
    "express-rate-limit": "^8.6.2",
    "globals": "^16.5.0",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "jszip": "^3.10.1",
    "jwks-rsa": "^3.2.2",
    "node-fetch": "^3.3.2",
    "node-unrar-js": "^2.0.2",
    "onnxruntime-node": "^1.29.0",
    "sharp": "^0.35.4",
    "xml2js": "^0.6.2",
    "yauzl": "^2.10.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "autoprefixer": "^10.5.4",
    "eslint-plugin-html": "^8.1.4",
    "jest": "^30.4.2",
    "jest-environment-jsdom": "^30.4.1",
    "tailwindcss": "^3.4.19",
    "vite": "^8.2.2"
  }
}
